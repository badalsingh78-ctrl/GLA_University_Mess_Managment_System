NODE_ENV=development
PORT=4000

# Local MongoDB, or your own MongoDB Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/gla_mess_management

# Create these credentials in Google Cloud Console and Razorpay.
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
CALLBACK_URL=http://localhost:4000/api/auth/google/callback
FRONTEND=http://localhost:3000
ADMIN=replace-with-admin-email@example.com
PAY_ID=
PAY_SECRET=

# Replace with a long, random value before running.
SESSION_SECRET=replace-with-a-long-random-secret
